# Example Terraform variables file
# Copy this file to terraform.tfvars and customize the values

# Environment configuration
environment = "dev"  # Options: dev, staging, prod
location    = "East US"
project_name = "umbraco"

# SQL Server configuration
sql_admin_username = "sqladmin"

# App Service configuration
app_service_sku = "P1v3"  # Options: B1, B2, B3, S1, S2, S3, P1v2, P2v2, P3v2, P1v3, P2v3, P3v3

# SQL Database configuration
sql_database_sku = "S2"  # Options: Basic, S0, S1, S2, S3, P1, P2, P4, P6, P11, P15

# Feature flags
enable_application_gateway = true
enable_cdn = true
enable_backup = true

# Security configuration
allowed_ip_ranges = [
  # "203.0.113.0/24",  # Example: Office IP range
  # "198.51.100.0/24"  # Example: Home IP range
]

# Custom domain (optional)
custom_domain = ""  # Example: "myumbracosite.com"

# Resource tags
tags = {
  Project     = "Umbraco CMS"
  Environment = "Development"
  Owner       = "DevOps Team"
  CostCenter  = "IT"
  ManagedBy   = "Terraform"
}