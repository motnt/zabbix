{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=sql-connection-string)"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "your-umbraco-id",
        "SanitizeTinyMce": true,
        "ReservedUrls": "~/config/,~/install/,~/umbraco/",
        "ReservedPaths": "~/app_plugins/,~/install/,~/mini-profiler-resources/,~/umbraco/"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": false,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true,
          "KeepAllVersionsNewerThanDays": 7,
          "KeepLatestVersionPerDayForDays": 90
        },
        "Imaging": {
          "Cache": {
            "BrowserMaxAge": "7.00:00:00",
            "CacheMaxAge": "365.00:00:00"
          }
        },
        "ContentImageAutoFillProperties": [
          {
            "Alias": "umbracoFile",
            "WidthFieldAlias": "umbracoWidth",
            "HeightFieldAlias": "umbracoHeight",
            "LengthFieldAlias": "umbracoBytes",
            "ExtensionFieldAlias": "umbracoExtension"
          }
        ]
      },
      "Security": {
        "BackOfficeHost": "your-domain.com",
        "AuthCookieName": "UMB_UCONTEXT",
        "AuthCookieDomain": "",
        "AuthCookieTimeout": "1.00:00:00",
        "KeepUserLoggedIn": false,
        "HideDisabledUsersInBackoffice": false,
        "UserPassword": {
          "RequiredLength": 10,
          "RequireNonLetterOrDigit": false,
          "RequireDigit": false,
          "RequireLowercase": false,
          "RequireUppercase": false,
          "HashAlgorithmType": "PBKDF2.ASPNETCORE.V3",
          "MaxFailedAccessAttemptsBeforeLockout": 5
        }
      },
      "Hosting": {
        "Debug": false,
        "ApplicationVirtualPath": "/",
        "LocalTempStorageLocation": "Default"
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Version"
      },
      "WebRouting": {
        "TryMatchingEndpointsForAllPages": false,
        "TrySkipIisCustomErrors": false,
        "InternalRedirectPreservesTemplate": false,
        "DisableAlternativeTemplates": false,
        "ValidateAlternativeTemplates": false,
        "DisableFindContentByIdPath": false,
        "DisableRedirectUrlTracking": false,
        "UrlProviderMode": "Auto"
      },
      "Unattended": {
        "InstallUnattended": false,
        "UnattendedUserName": "",
        "UnattendedUserEmail": "",
        "UnattendedUserPassword": ""
      },
      "TypeFinder": {
        "AssembliesAcceptingLoadExceptions": [
          "Lucene.Net.dll"
        ]
      },
      "RequestHandler": {
        "AddTrailingSlash": true,
        "ConvertUrlsToAscii": "try"
      },
      "Examine": {
        "LuceneDirectoryFactory": "SyncedTempFileSystemDirectoryFactory"
      },
      "Plugins": {
        "BrowseFileSystem": true
      },
      "Logging": {
        "MaxLogAge": "1.00:00:00",
        "EnableLogging": true,
        "EnableAsyncLogging": true
      },
      "HealthChecks": {
        "Notification": {
          "Enabled": true,
          "FirstRunTime": "00:00",
          "Period": "24:00:00",
          "NotificationMethods": {
            "email": {
              "Enabled": true,
              "Verbosity": "Summary",
              "FailureOnly": false
            }
          }
        },
        "DisabledChecks": [
          {
            "Id": "1B5D221B-CE99-4193-97F5-3004EC2CA716"
          }
        ]
      }
    },
    "Storage": {
      "AzureBlob": {
        "Media": {
          "ConnectionString": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=storage-connection-string)",
          "ContainerName": "media",
          "VirtualPath": "~/media/"
        }
      }
    },
    "Deploy": {
      "Settings": {
        "ApiKey": "",
        "WorkDirectory": "~/App_Data/Deploy/",
        "Timeout": 60000,
        "SourceDeployFile": "~/App_Data/Deploy/deploy.uda"
      }
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=your-instrumentation-key;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus.livediagnostics.monitor.azure.com/"
  },
  "AllowedHosts": "*"
}